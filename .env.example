APP_NAME=office-intelligence-automation-platform-oiap
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]
# PostgreSQL connection parts. The application builds the SQLAlchemy URL from
# these, so no complete connection string is stored anywhere. On AWS ECS,
# DB_USER and DB_PASSWORD are injected from the RDS-managed Secrets Manager
# secret and DB_HOST is the RDS endpoint.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=oiap
DB_USER=oiap
DB_PASSWORD=change-me
DATABASE_POOL_SIZE=5
DATABASE_CONNECT_TIMEOUT_SECONDS=5
EMBEDDING_DIMENSION=1536

# Disposable PostgreSQL/pgvector database used only by integration tests.
TEST_DATABASE_URL=postgresql+psycopg://oiap:change-me@localhost:5432/oiap_test

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_OUTPUT_TOKENS=800